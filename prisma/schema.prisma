generator client {
  provider = "prisma-client-js"
}

// SQLite for local development. For production (e.g. Vercel), switch the
// provider to "postgresql" and point DATABASE_URL at a hosted Postgres DB.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model RankingSet {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  author      String
  description String?
  isOfficial  Boolean        @default(false)
  editKeyHash String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  entries     RankingEntry[]
}

model RankingEntry {
  id       Int        @id @default(autoincrement())
  setId    String
  playerId String
  pos      String // section the player is ranked in: F, M, D or GK
  rank     Int // rank within that position (1 = best)
  tier     String // S, A, B, C, D, E, F or Z
  set      RankingSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([setId, playerId])
  @@index([setId, pos, rank])
}
