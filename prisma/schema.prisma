generator client {
  provider = "prisma-client-js"
}

// Postgres (e.g. Neon via Vercel). DATABASE_URL is the pooled connection the
// site uses; DATABASE_URL_UNPOOLED is a direct connection used for schema
// changes. Vercel's Neon integration sets both automatically. Locally, set both
// to the same connection string.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model RankingSet {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  author      String
  description String?
  isOfficial  Boolean        @default(false)
  editKeyHash String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  entries     RankingEntry[]
}

model RankingEntry {
  id       Int        @id @default(autoincrement())
  setId    String
  playerId String
  pos      String // section the player is ranked in: F, M, D or GK
  rank     Int // rank within that position (1 = best)
  tier     String // S, A, B, C, D, E, F or Z
  set      RankingSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([setId, playerId])
  @@index([setId, pos, rank])
}
