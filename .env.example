# Postgres connection strings. On Vercel, the Neon integration sets both of
# these for you. Locally, paste the same connection string into both.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Master key: lets you edit or delete ANY rankings list, including the official
# one, and create a new official list. Use a long random string.
ADMIN_KEY="change-me"

# Lineup Setter: encrypts stored Sleeper sign-ins and signs sessions (16+ chars).
LINEUP_SECRET="change-me-to-a-long-random-string"
# Shared with the GitHub Actions scheduler (repository secret of the same name).
CRON_SECRET="change-me-to-another-long-random-string"
